# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://aizorix:aizorix_dev@localhost:5433/aizorix?schema=public"

# AI provider (Phase 2)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# WhatsApp provider (Phase 3) — Twilio. Leave blank to use the in-process
# stub (logs outbound messages to the dev server console).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+34911000000"

# Clinic defaults
DEFAULT_CLINIC_SLUG="bellem"
DEFAULT_TIMEZONE="Europe/Madrid"

# Auth (Phase 4). AUTH_SECRET is required by NextAuth — generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
# Set SMTP_HOST etc. to send real magic-link emails. If unset, dev mode
# prints the magic link to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@aizorix.dev"
