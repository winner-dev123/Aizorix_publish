# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://aizorix:aizorix_dev@localhost:5433/aizorix?schema=public"

# AI provider (Phase 2)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# WhatsApp provider (Phase 3) — Twilio. Leave blank to use the in-process
# stub (logs outbound messages to the dev server console).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+34911000000"

# Clinic defaults
DEFAULT_CLINIC_SLUG="bellem"
DEFAULT_TIMEZONE="Europe/Madrid"

# Observability (Phase 6.8). Optional bearer-token gate for /api/metrics.
# Leave empty in dev (the endpoint stays open). Set to any random string in
# production to lock the Prometheus exposition behind a header check.
METRICS_AUTH_TOKEN=""

# Auth (Phase 4). REQUIRED by NextAuth. Generate with:
#   openssl rand -base64 32
# If left empty in development, the app falls back to an unsafe dev secret
# and prints a warning. In production (NODE_ENV=production), an empty value
# will cause NextAuth to throw MissingSecret on the first /signin request.
AUTH_SECRET=""
# Set SMTP_HOST etc. to send real magic-link emails. If unset, dev mode
# prints the magic link to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="no-reply@aizorix.dev"
