// Aizorix SaaS — AI receptionist for aesthetic clinics
// Multi-tenant: every domain row carries clinicId and is indexed accordingly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  Enums
// ============================================================

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  STAFF
}

enum PatientStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum Gender {
  FEMALE
  MALE
  ANY
}

enum PriceType {
  FIXED
  FROM
  RANGE
  ON_REQUEST
}

enum ComplexityLevel {
  LIGHT
  STANDARD
  ADVANCED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CreatedBy {
  BOT
  HUMAN
  STAFF
}

enum Channel {
  WHATSAPP
  WEB
  SMS
  PHONE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum HandoffStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum WhatsAppProvider {
  YCLOUD
  META
  TWILIO
}

enum AiTone {
  FORMAL
  CASUAL
  NEUTRAL
}

enum ClinicPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ============================================================
//  Tenancy
// ============================================================

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Madrid")
  locale    String   @default("es-ES")
  // E.164 number of the clinic's WhatsApp Business line; the inbound webhook
  // routes messages to this clinic by matching the "To" address.
  whatsappNumber String? @unique
  // Booking policy
  minLeadMinutes      Int @default(120)
  slotGranularityMin  Int @default(30)
  // AI receptionist config. Edited from /app/settings/ai; consumed by
  // buildSystemPrompt(). Tone steers de/tú/usted; guidance is appended as
  // a free-text "INSTRUCCIONES ADICIONALES" block.
  aiTone     AiTone   @default(NEUTRAL)
  aiGuidance String?
  // Module feature toggles (Phase 6.9). Stored as an array of stable
  // string keys defined in src/server/actions/module-catalogue.ts.
  // Defaults to all modules enabled.
  activeModules String[] @default(["pipeline", "campaigns", "metrics", "ai-demo", "agenda"])
  // Subscription plan tier (Phase 6.10). Not self-service — updated by
  // the platform owner in the DB; the dashboard displays it read-only.
  plan ClinicPlan @default(PRO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  patients            Patient[]
  treatments          Treatment[]
  treatmentCategories TreatmentCategory[]
  technicians         Technician[]
  technicianTreatments TechnicianTreatment[]
  appointments        Appointment[]
  conversations       Conversation[]
  businessHours       ClinicBusinessHours[]
  blockedSlots        BlockedSlot[]
  strategyRules       ClinicStrategyRule[]
  handoffs            HumanHandoff[]
  whatsapp            WhatsAppIntegration?
  aiMemories          AiMemory[]
}

model User {
  id            String    @id @default(cuid())
  clinicId      String
  email         String
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(STAFF)
  passwordHash  String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clinic   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  handoffs HumanHandoff[]
  accounts Account[]
  sessions Session[]

  @@unique([clinicId, email])
  @@index([clinicId])
}

// ============================================================
//  CRM (Patient replaces the old "CRM" Google Sheet tab)
// ============================================================

model Patient {
  id        String        @id @default(cuid())
  clinicId  String
  firstName String
  lastName  String?
  phone     String
  email     String?
  gender    Gender?
  dob       DateTime?
  status    PatientStatus @default(LEAD)
  notes     String?
  source    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  conversations Conversation[]
  memories      AiMemory[]
  handoffs      HumanHandoff[]

  @@unique([clinicId, phone])
  @@index([clinicId, status])
}

// ============================================================
//  Treatments (replace INFO_TRATAMIENTOS sheet)
// ============================================================

model TreatmentCategory {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  slug      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatments Treatment[]

  @@unique([clinicId, slug])
}

model Treatment {
  id                String          @id @default(cuid())
  clinicId          String
  categoryId        String?
  name              String
  slug              String
  subTreatment      String?
  description       String?
  requiresValuation Boolean         @default(false)
  durationMinutes   Int
  bufferMinutes     Int             @default(0)
  price             Decimal?        @db.Decimal(10, 2)
  showPrice         Boolean         @default(true)
  priceType         PriceType       @default(FIXED)
  priceNote         String?
  botMessage        String?
  contraindications String[]
  genderApplicable  Gender          @default(ANY)
  requirements      String?
  complexity        ComplexityLevel @default(STANDARD)
  keywords          String[]
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category     TreatmentCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  technicians  TechnicianTreatment[]
  appointments Appointment[]

  @@unique([clinicId, slug])
  @@index([clinicId, active])
}

// ============================================================
//  Technicians (replace TÉCNICOS sheet)
// ============================================================

model Technician {
  id                String   @id @default(cuid())
  clinicId          String
  name              String
  email             String?
  phone             String?
  color             String?
  // Leo flag: when true the assignment service prefers other techs first
  prioritySensitive Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic       Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatments   TechnicianTreatment[]
  appointments Appointment[]
  blockedSlots BlockedSlot[]

  @@index([clinicId, active])
}

model TechnicianTreatment {
  id             String  @id @default(cuid())
  clinicId       String
  technicianId   String
  treatmentId    String
  isPrimary      Boolean @default(false)
  isPreferred    Boolean @default(false)
  isExclusive    Boolean @default(false)
  isExcluded     Boolean @default(false)
  isFallbackOnly Boolean @default(false)

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  treatment  Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([technicianId, treatmentId])
  @@index([clinicId, treatmentId])
}

// ============================================================
//  Schedule (replaces Google Calendar)
// ============================================================

model ClinicBusinessHours {
  id        String   @id @default(cuid())
  clinicId  String
  dayOfWeek Int // 0=Sunday … 6=Saturday
  opensAt   String // "HH:mm" in clinic timezone
  closesAt  String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, dayOfWeek])
}

model BlockedSlot {
  id           String   @id @default(cuid())
  clinicId     String
  technicianId String? // null = clinic-wide block
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime @default(now())

  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([clinicId, startsAt])
  @@index([technicianId, startsAt])
}

model Appointment {
  id             String            @id @default(cuid())
  clinicId       String
  patientId      String
  technicianId   String
  treatmentId    String
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(CONFIRMED)
  notes          String?
  createdBy      CreatedBy         @default(BOT)
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  treatment  Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Restrict)

  @@index([clinicId, startsAt])
  @@index([technicianId, startsAt, status])
  @@index([patientId, startsAt])
}

// ============================================================
//  Conversations + memory (replace Postgres chat_histories in n8n)
// ============================================================

model Conversation {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String?
  channel        Channel  @default(WHATSAPP)
  externalChatId String? // e.g. WhatsApp phone E.164
  requiresHuman  Boolean  @default(false)
  // When true, the orchestrator records inbound messages but skips the LLM
  // call. Staff toggle this from the conversation thread; `escalate_to_human`
  // also sets it; `resolveHandoffAction` clears it.
  botPaused      Boolean  @default(false)
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  clinic   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages Message[]
  handoffs HumanHandoff[]

  @@unique([clinicId, channel, externalChatId])
  @@index([clinicId, lastMessageAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiMemory {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, key])
  @@index([clinicId])
}

// ============================================================
//  Strategy + handoff + integrations
// ============================================================

model ClinicStrategyRule {
  id        String   @id @default(cuid())
  clinicId  String
  key       String
  value     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
}

model HumanHandoff {
  id             String        @id @default(cuid())
  clinicId       String
  conversationId String
  patientId      String?
  reason         String
  status         HandoffStatus @default(OPEN)
  assignedUserId String?
  openedAt       DateTime      @default(now())
  resolvedAt     DateTime?

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, status])
}

model WhatsAppIntegration {
  id            String           @id @default(cuid())
  clinicId      String           @unique
  provider      WhatsAppProvider
  apiKey        String
  phoneNumberId String
  displayPhone  String?
  webhookSecret String
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// ============================================================
//  NextAuth (Auth.js v5) — managed by @auth/prisma-adapter
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
